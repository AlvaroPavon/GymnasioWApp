{
  "name": "@gimnasiowapp/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "export:android": "expo export --platform android --output-dir dist/android",
    "export:ios": "expo export --platform ios --output-dir dist/ios",
    "test": "node --experimental-default-type=module --test",
    "typecheck": "tsc --noEmit",
    "test:helpers": "node --experimental-default-type=module --test tests/activityCalendar.test.mjs",
    "check:privacy-link": "node scripts/check-privacy-policy-link.mjs",
    "release:check": "node scripts/validate-release-env.mjs && npm run check:privacy-link",
    "release:check:android": "node scripts/validate-release-env.mjs android && npm run check:privacy-link",
    "build:android": "npm run release:check:android && npx eas-cli@22.3.0 build --platform android --profile production",
    "build:ios": "npm run release:check && npx eas-cli@22.3.0 build --platform ios --profile production-ios",
    "submit:android": "npx eas-cli@22.3.0 submit --platform android --profile production",
    "submit:ios": "npx eas-cli@22.3.0 submit --platform ios --profile production"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.2.5",
    "@react-navigation/native-stack": "^7.16.0",
    "axios": "^1.16.1",
    "expo": "^57.0.16",
    "expo-image-picker": "~57.0.13",
    "expo-notifications": "~57.0.14",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.14",
    "typescript": "~6.0.3"
  }
}
