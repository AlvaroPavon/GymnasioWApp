{
  "name": "@gimnasiowapp/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "export:android": "expo export --platform android --output-dir dist/android",
    "export:ios": "expo export --platform ios --output-dir dist/ios",
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "test:helpers": "node --test tests/activityCalendar.test.mjs",
    "check:privacy-link": "node scripts/check-privacy-policy-link.mjs",
    "release:check": "node scripts/validate-release-env.mjs && npm run check:privacy-link",
    "release:check:android": "node scripts/validate-release-env.mjs android && npm run check:privacy-link",
    "build:android": "npm run release:check:android && npx eas-cli@24.7.0 build --platform android --profile production",
    "build:ios": "npm run release:check && npx eas-cli@24.7.0 build --platform ios --profile production-ios",
    "submit:android": "npx eas-cli@24.7.0 submit --platform android --profile production",
    "submit:ios": "npx eas-cli@24.7.0 submit --platform ios --profile production"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.2",
    "axios": "^1.20.0",
    "expo": "57.0.25",
    "expo-build-properties": "~57.0.22",
    "expo-image-picker": "~57.0.20",
    "expo-notifications": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-system-ui": "~57.0.4",
    "phosphor-react-native": "^3.0.6",
    "react": "19.2.3",
    "react-native": "^0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.14",
    "typescript": "~6.0.3"
  }
}
