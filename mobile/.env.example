# Public API URL embedded in the mobile bundle.
# Production must be HTTPS and must not point to localhost.
EXPO_PUBLIC_API_URL=https://api.gimnasiowapp.com

# Store identity. Change these before the first upload; stores treat them as permanent IDs.
APP_NAME=GimnasioWapp
APP_SLUG=gimnasiowapp
APP_SCHEME=gimnasiowapp
APP_VERSION=1.0.0
IOS_BUNDLE_IDENTIFIER=com.gimnasiowapp.mobile
ANDROID_PACKAGE=com.gimnasiowapp.mobile
IOS_BUILD_NUMBER=1
ANDROID_VERSION_CODE=1
