# The Android production profile uses credentialsSource=local, so EAS needs
# credentials.json and the referenced upload-key JKS. Exclude every unrelated
# credential or backup so it cannot enter the cloud build archive.
credentials/*.secrets.json
credentials/*.pem
credentials/*.p8
credentials/*.p12
credentials/*.pfx
credentials/*.mobileprovision
google-services.json
GoogleService-Info.plist
google-service-account*.json
service-account*.json
