{
  "name": "@gimnasiowapp/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm run prisma:generate && tsc -p tsconfig.json && node scripts/copy-generated-prisma.mjs",
    "start": "node dist/src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "test": "npm run test:db:up && cross-env NODE_ENV=test JWT_SECRET=change_me_to_at_least_32_chars_for_tests DATABASE_URL=mysql://gimnasio:gimnasio@127.0.0.1:3307/gimnasio_test npm run test:ci",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test.yml down --volumes --remove-orphans",
    "test:ci": "tsx tests/helpers/database.ts && npm run prisma:generate && prisma migrate deploy && jest --runInBand"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "date-fns": "4.3.0",
    "dotenv": "17.4.2",
    "expo-server-sdk": "6.1.0",
    "express": "5.2.1",
    "express-rate-limit": "8.5.2",
    "helmet": "8.2.0",
    "jsonwebtoken": "9.0.3",
    "morgan": "1.10.1",
    "multer": "^2.1.1",
    "node-cron": "4.2.1",
    "sharp": "0.35.3",
    "ws": "^8.21.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@prisma/config": "6.19.3",
    "@standard-schema/spec": "1.1.0",
    "@swc/core": "1.15.40",
    "@swc/jest": "0.2.39",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/morgan": "1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node": "20.19.25",
    "@types/supertest": "7.2.0",
    "@types/ws": "^8.18.1",
    "c12": "3.1.0",
    "cross-env": "10.1.0",
    "deepmerge-ts": "7.1.5",
    "effect": "3.21.0",
    "empathic": "2.0.0",
    "fast-check": "3.23.1",
    "jest": "30.4.2",
    "prisma": "6.19.3",
    "supertest": "7.2.2",
    "tsx": "4.22.3",
    "typescript": "5.9.3"
  }
}
